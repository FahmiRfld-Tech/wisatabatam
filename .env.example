# Backend-only settings. Never expose service keys in browser code.
# Hosted Supabase normally supplies its own project URL and server keys.
SUPABASE_URL=
SUPABASE_SECRET_KEYS={}
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Example local origin; set explicit authorized deployment origins separately.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CHAT_GLOBAL_RPM=30
CHAT_DAILY_LIMIT=500
